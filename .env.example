# Vite client configuration. These values are not secrets.
VITE_API_ENABLED=false
VITE_API_BASE_URL=/api

# Server configuration. Keep real values in .env.local or deployment secrets.
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8787
API_SERVER_ALLOWED_HOSTS=localhost,127.0.0.1
# 신뢰하는 리버스 프록시의 소켓 IP만 입력합니다. 로컬 직접 실행은 비워 둡니다.
API_TRUSTED_PROXY_ADDRESSES=
CORS_ORIGIN=http://localhost:5173
API_CACHE_TTL_MS=60000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=60

# 행정안전부 지방재정365 계약현황 API. 실제 값은 .env.local에만 입력합니다.
# 공공데이터포털의 지방재정365 API 안내서에서 발급받은 원천 API URL을 입력합니다.
LOFIN_CONTRACT_API_URL=
LOFIN_CONTRACT_API_KEY=
LOFIN_CONTRACT_KEY_PARAM=key
LOFIN_CONTRACT_PAGE_SIZE=100
LOFIN_CONTRACT_YEAR=
LOFIN_CONTRACT_DATE=

# 국회 국회사무처 의안정보 통합 API. 실제 값은 .env.local에만 입력합니다.
# 공공데이터포털 활용신청 후 연결된 공식 XML API URL과 서버용 서비스키를 사용합니다.
VITE_LEGISLATION_API_ENABLED=false
ASSEMBLY_BILL_API_URL=
ASSEMBLY_BILL_API_KEY=
ASSEMBLY_BILL_KEY_PARAM=KEY
ASSEMBLY_BILL_RESPONSE_TYPE=xml
ASSEMBLY_BILL_PAGE_SIZE=100
ASSEMBLY_BILL_AGE=

# 금융감독원 OpenDART 기업개황·공시검색 API. 실제 인증키는 .env.local에만 입력합니다.
# 브라우저에는 DART_API_KEY를 노출하지 않고 server/providers/dartProvider.js가 서버에서 호출합니다.
VITE_DART_API_ENABLED=false
DART_API_KEY=
DART_DISCLOSURE_PAGE_SIZE=10
