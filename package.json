{
  "name": "drawing-material-calculator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node --env-file-if-exists=.env.local server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:3d-model": "node --experimental-strip-types scripts/verify-3d-model.ts",
    "verify:drawing-pipeline": "node --experimental-strip-types scripts/verify-drawing-pipeline.ts",
    "verify:height-extraction": "node --experimental-strip-types scripts/verify-height-extraction.ts",
    "verify:cutting-optimization": "node --experimental-strip-types scripts/verify-cutting-optimization.ts",
    "verify:inventory-cutting": "node --experimental-strip-types scripts/verify-inventory-cutting.ts",
    "verify:domain-regressions": "node --experimental-strip-types scripts/verify-domain-regressions.ts",
    "verify:regressions": "node --experimental-strip-types scripts/verify-regressions.ts",
    "verify:server-boundaries": "node scripts/verify-server-boundaries.mjs",
    "verify:all": "run-s verify:3d-model verify:drawing-pipeline verify:height-extraction verify:cutting-optimization verify:inventory-cutting verify:domain-regressions verify:regressions verify:server-boundaries",
    "check": "run-s typecheck lint:check verify:all build",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:check": "run-s lint:check:oxlint lint:check:eslint",
    "lint:check:oxlint": "oxlint .",
    "lint:check:eslint": "eslint . --no-cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "element-plus": "^2.14.3",
    "fast-xml-parser": "^5.10.1",
    "pdfjs-dist": "^6.2.108",
    "pinia": "^4.0.2",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.76.0",
    "eslint-plugin-vue": "~10.9.2",
    "globals": "^17.7.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "^1.76.0",
    "prettier": "3.9.5",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
